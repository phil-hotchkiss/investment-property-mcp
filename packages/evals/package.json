{
  "name": "@rental-deal-math/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "evals": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin.js",
    "schema": "node -e \"import('./dist/transcript.js').then((m) => process.stdout.write(JSON.stringify(m.transcriptJsonSchema(), null, 2) + '\\n'))\" > transcript.schema.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "~1.32.2",
    "@rental-deal-math/core": "workspace:*",
    "@rental-deal-math/mcp-server": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
